# Canonical local runtime location for public benchmark code.  Publish lock
# files and compact results, never populated environments/checkouts/caches.
/benchmarks/external_models/runtime/
/benchmarks/external_models/environments/*/.venv/
/benchmarks/external_models/environments/*/.cache/
/benchmarks/external_models/environments/*/upstream
/benchmarks/external_models/environments/*/weights
/benchmarks/external_models/environments/*/bin/
/benchmarks/external_models/environments/*/logs/
/benchmarks/external_models/environments/*/state/
/benchmarks/external_models/environments/logs/

# Model-local external benchmark workspaces.  Keep only reproducible uv
